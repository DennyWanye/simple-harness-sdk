{
  "session_history.search": {
    "request": "SearchRequest",
    "response": "SearchPage",
    "scope": "bound AgentSession only; cursor_purpose=MODEL_SEARCH"
  },
  "session_history.read": {
    "request": "HistoryReadRequest",
    "response": "HistoryReadPage",
    "scope": "bound AgentSession only; cursor_purpose=MODEL_READ"
  },
  "skill.discover": {
    "request": "CatalogueReadCommand",
    "response": "CataloguePage",
    "scope": "namespace forced by session; MODEL access view; submitted namespace must equal session"
  },
  "skill.load": {
    "request": "SkillLoadRequest",
    "response": "SkillUse",
    "scope": "INSTRUCTIONS; actual instruction exposure next provider request"
  },
  "skill.execute": {
    "request": "SkillExecutionRequest",
    "response": "ToolResultView",
    "scope": "SCRIPT/WORKFLOW original executor"
  },
  "tool.discover": {
    "request": "CatalogueReadCommand",
    "response": "CataloguePage",
    "scope": "TOOL only; MODEL access view"
  },
  "tool.execute": {
    "request": "ToolExecutionRequest",
    "response": "ToolResultView",
    "scope": "exact exposed tool; side effects original OPS only"
  }
}
