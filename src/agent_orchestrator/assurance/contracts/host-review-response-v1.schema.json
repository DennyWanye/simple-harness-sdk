{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.simpleharness.invalid/assurance/1.1/host-review-response-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "mission_id",
    "view",
    "snapshot_seq",
    "root_incarnation_id",
    "sdk_fingerprint",
    "host_fingerprint",
    "review_key",
    "purpose",
    "package_ref",
    "record_ref",
    "official_status",
    "verdict",
    "assessments",
    "next_cursor",
    "truncated",
    "current_use"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "request_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    },
    "mission_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    },
    "view": {
      "enum": [
        "CURRENT",
        "HISTORY"
      ]
    },
    "snapshot_seq": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "root_incarnation_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    },
    "sdk_fingerprint": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "host_fingerprint": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "review_key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    },
    "purpose": {
      "enum": [
        "TASK_CONTENT",
        "METHOD_PLAN",
        "COMPOSITION",
        "ACTION_PROPOSAL",
        "OPERATION_OUTCOME",
        "MISSION_FINAL"
      ]
    },
    "package_ref": {
      "allOf": [
        {
          "$ref": "common.schema.json#/$defs/ref"
        },
        {
          "properties": {
            "kind": {
              "enum": [
                "review_package"
              ]
            }
          }
        }
      ]
    },
    "record_ref": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "common.schema.json#/$defs/ref"
        }
      ]
    },
    "official_status": {
      "enum": [
        "PENDING",
        "OFFICIAL",
        "REJECTED_SOURCE",
        "UNAVAILABLE"
      ]
    },
    "verdict": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "enum": [
            "ACCEPT",
            "REWORK",
            "REJECT",
            "INCONCLUSIVE"
          ]
        }
      ]
    },
    "assessments": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "criterion_id",
          "model_grade",
          "effective_grade",
          "check_gate",
          "reason_codes",
          "evidence_labels"
        ],
        "properties": {
          "criterion_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "model_grade": {
            "enum": [
              "PASS",
              "FAIL",
              "UNKNOWN"
            ]
          },
          "effective_grade": {
            "enum": [
              "PASS",
              "FAIL",
              "UNKNOWN"
            ]
          },
          "check_gate": {
            "enum": [
              "PASS",
              "FAIL",
              "UNKNOWN",
              "NOT_APPLICABLE"
            ]
          },
          "reason_codes": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048
            },
            "minItems": 0,
            "maxItems": 64
          },
          "evidence_labels": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^ev-[0-9a-f]{64}$"
            },
            "minItems": 0,
            "maxItems": 256
          }
        }
      },
      "minItems": 0,
      "maxItems": 100
    },
    "next_cursor": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        }
      ]
    },
    "truncated": {
      "type": "boolean"
    },
    "current_use": {
      "enum": [
        "USABLE",
        "STALE",
        "BLOCKED",
        "UNAVAILABLE"
      ]
    }
  }
}
