{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.simpleharness.invalid/assurance/1.1/review-record-binding-v2.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "mission_id",
    "review_key",
    "package_ref",
    "record_ref",
    "reviewer_agent_id",
    "reviewer_turn_ref",
    "raw_output_ref",
    "raw_output_hash",
    "codec_version",
    "consumed_check_refs",
    "exposed_evidence_refs",
    "evidence_manifest_hash",
    "binding_read_set",
    "disclosure_refs",
    "invocation_ordinal"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "mission_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    },
    "review_key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    },
    "package_ref": {
      "$ref": "common.schema.json#/$defs/pin"
    },
    "record_ref": {
      "$ref": "common.schema.json#/$defs/pin"
    },
    "reviewer_agent_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    },
    "reviewer_turn_ref": {
      "allOf": [
        {
          "$ref": "common.schema.json#/$defs/ref"
        },
        {
          "properties": {
            "kind": {
              "enum": [
                "agent_turn_receipt"
              ]
            }
          }
        }
      ]
    },
    "raw_output_ref": {
      "$ref": "common.schema.json#/$defs/ref"
    },
    "raw_output_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "codec_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    },
    "consumed_check_refs": {
      "type": "array",
      "minItems": 0,
      "maxItems": 256,
      "items": {
        "allOf": [
          {
            "$ref": "common.schema.json#/$defs/ref"
          },
          {
            "properties": {
              "kind": {
                "enum": [
                  "check_binding"
                ]
              }
            }
          }
        ]
      },
      "uniqueItems": true
    },
    "exposed_evidence_refs": {
      "type": "array",
      "minItems": 0,
      "maxItems": 1024,
      "items": {
        "$ref": "common.schema.json#/$defs/catalogue_entry"
      },
      "uniqueItems": true
    },
    "evidence_manifest_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "binding_read_set": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20000,
      "items": {
        "$ref": "common.schema.json#/$defs/read_item"
      },
      "uniqueItems": true
    },
    "disclosure_refs": {
      "type": "array",
      "minItems": 0,
      "maxItems": 128,
      "items": {
        "allOf": [
          {
            "$ref": "common.schema.json#/$defs/ref"
          },
          {
            "properties": {
              "kind": {
                "enum": [
                  "disclosure_receipt"
                ]
              }
            }
          }
        ]
      },
      "uniqueItems": true
    },
    "invocation_ordinal": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2
    }
  },
  "$defs": {
    "formula": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "criterion"
          ],
          "properties": {
            "criterion": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "all"
          ],
          "properties": {
            "all": {
              "type": "array",
              "minItems": 1,
              "maxItems": 256,
              "items": {
                "$ref": "#/$defs/formula"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "any"
          ],
          "properties": {
            "any": {
              "type": "array",
              "minItems": 1,
              "maxItems": 256,
              "items": {
                "$ref": "#/$defs/formula"
              }
            }
          }
        }
      ]
    }
  }
}
