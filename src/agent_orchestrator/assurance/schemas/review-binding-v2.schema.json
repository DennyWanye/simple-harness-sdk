{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.simpleharness.invalid/assurance/1.1/review-binding-v2.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "mission_id",
    "review_key",
    "package_ref",
    "round_no",
    "subject",
    "requirements_ref",
    "criterion_ids",
    "mandatory_ids",
    "formula",
    "check_requirements",
    "evidence_catalogue",
    "producer_agent_ids",
    "reviewer_policy_ref",
    "read_set",
    "context_policy_ref",
    "criterion_policy_ref",
    "catalogue_hash"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "mission_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    },
    "review_key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    },
    "package_ref": {
      "$ref": "common.schema.json#/$defs/pin"
    },
    "round_no": {
      "type": "integer",
      "minimum": 1
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "purpose",
        "target",
        "owner_task_ref",
        "occurrence_id",
        "completion_scope_ref",
        "method_instance_ref",
        "input_manifest_hash",
        "output_manifest_hash"
      ],
      "properties": {
        "purpose": {
          "enum": [
            "TASK_CONTENT",
            "METHOD_PLAN",
            "COMPOSITION",
            "ACTION_PROPOSAL",
            "OPERATION_OUTCOME",
            "MISSION_FINAL"
          ]
        },
        "target": {
          "$ref": "common.schema.json#/$defs/ref"
        },
        "owner_task_ref": {
          "$ref": "common.schema.json#/$defs/pin"
        },
        "occurrence_id": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048
            }
          ]
        },
        "completion_scope_ref": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "common.schema.json#/$defs/pin"
            }
          ]
        },
        "method_instance_ref": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "common.schema.json#/$defs/pin"
            }
          ]
        },
        "input_manifest_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "output_manifest_hash": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          ]
        }
      }
    },
    "requirements_ref": {
      "$ref": "common.schema.json#/$defs/pin"
    },
    "criterion_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2048
      },
      "uniqueItems": true
    },
    "mandatory_ids": {
      "type": "array",
      "minItems": 0,
      "maxItems": 256,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2048
      },
      "uniqueItems": true
    },
    "formula": {
      "$ref": "#/$defs/formula"
    },
    "check_requirements": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "criterion_id",
          "mode",
          "any_check_sets"
        ],
        "properties": {
          "criterion_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "mode": {
            "enum": [
              "SEMANTIC",
              "CHECKED"
            ]
          },
          "any_check_sets": {
            "type": "array",
            "minItems": 0,
            "maxItems": 16,
            "items": {
              "type": "array",
              "minItems": 1,
              "maxItems": 32,
              "items": {
                "allOf": [
                  {
                    "$ref": "common.schema.json#/$defs/ref"
                  },
                  {
                    "properties": {
                      "kind": {
                        "enum": [
                          "check_spec"
                        ]
                      }
                    }
                  }
                ]
              },
              "uniqueItems": true
            }
          }
        }
      }
    },
    "evidence_catalogue": {
      "type": "array",
      "minItems": 0,
      "maxItems": 1024,
      "items": {
        "$ref": "common.schema.json#/$defs/catalogue_entry"
      },
      "uniqueItems": true
    },
    "producer_agent_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2048
      },
      "uniqueItems": true
    },
    "reviewer_policy_ref": {
      "$ref": "common.schema.json#/$defs/pin"
    },
    "read_set": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20000,
      "items": {
        "$ref": "common.schema.json#/$defs/read_item"
      },
      "uniqueItems": true
    },
    "context_policy_ref": {
      "$ref": "common.schema.json#/$defs/pin"
    },
    "criterion_policy_ref": {
      "allOf": [
        {
          "$ref": "common.schema.json#/$defs/ref"
        },
        {
          "properties": {
            "kind": {
              "enum": [
                "check_policy"
              ]
            }
          }
        }
      ]
    },
    "catalogue_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "$defs": {
    "formula": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "criterion"
          ],
          "properties": {
            "criterion": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "all"
          ],
          "properties": {
            "all": {
              "type": "array",
              "minItems": 1,
              "maxItems": 256,
              "items": {
                "$ref": "#/$defs/formula"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "any"
          ],
          "properties": {
            "any": {
              "type": "array",
              "minItems": 1,
              "maxItems": 256,
              "items": {
                "$ref": "#/$defs/formula"
              }
            }
          }
        }
      ]
    }
  }
}
