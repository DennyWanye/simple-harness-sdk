{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:simpleharness:aer:validity-witness:1",
  "title": "validity-witness",
  "description": "拟议内部结构合同；不验证真实身份、语义、权限或执行效果；不替代既有消息版本。",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "witness_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "consumer_ref": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "task",
            "method",
            "requirements",
            "artifact",
            "source",
            "observation",
            "review",
            "acceptance",
            "resolution",
            "operation",
            "tool_receipt",
            "knowledge"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "content_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "kind",
        "id",
        "revision",
        "content_hash"
      ],
      "additionalProperties": false
    },
    "purpose": {
      "enum": [
        "PLAN",
        "START",
        "MAINTAIN",
        "ACCEPT",
        "CONTEXT",
        "DISCLOSE",
        "RECOVERY"
      ]
    },
    "truth": {
      "enum": [
        "TRUE",
        "FALSE",
        "UNKNOWN",
        "CONFLICT"
      ]
    },
    "freshness": {
      "enum": [
        "CURRENT",
        "STALE",
        "REVOKED"
      ]
    },
    "availability": {
      "enum": [
        "READABLE",
        "REDACTED",
        "UNAVAILABLE"
      ]
    },
    "decision": {
      "enum": [
        "USABLE",
        "NEEDS_REVIEW",
        "BLOCKED",
        "UNAVAILABLE"
      ]
    },
    "scope_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "scope_epoch": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "support_revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "as_of_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "not_after_ms": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "support_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "enum": [
              "task",
              "method",
              "requirements",
              "artifact",
              "source",
              "observation",
              "review",
              "acceptance",
              "resolution",
              "operation",
              "tool_receipt",
              "knowledge"
            ]
          },
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "revision": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "content_hash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "kind",
          "id",
          "revision",
          "content_hash"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "reason_codes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512
      },
      "minItems": 0
    }
  },
  "required": [
    "schema_version",
    "witness_id",
    "consumer_ref",
    "purpose",
    "truth",
    "freshness",
    "availability",
    "decision",
    "scope_id",
    "scope_epoch",
    "support_revision",
    "as_of_ms",
    "not_after_ms",
    "support_refs",
    "reason_codes"
  ],
  "additionalProperties": false
}
